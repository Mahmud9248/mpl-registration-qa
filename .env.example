# Where the app under test is running. scripts/run_local_app.sh serves it here.
BASE_URL=http://127.0.0.1:8788

# Authority (admin) credentials for the environment under test.
# Never point these at production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=qa-admin-pass

# Optional: path to a preinstalled Chromium (leave empty to use Playwright's own download)
CHROMIUM_EXECUTABLE=
