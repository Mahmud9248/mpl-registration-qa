{"uid":"2d6bd38d28ac539b","name":"TC-API-020 Ten players registering at the same moment all succeed","fullName":"tests.api.test_registrations_api#test_concurrent_registrations","historyId":"a75564d946fc7e237e0df6b6570d0636","time":{"start":1795499569694,"stop":1795499569897,"duration":203},"status":"skipped","statusMessage":"XFAIL BUG-001: concurrent registrations collide on the generated id\n\nAssertionError: lost registrations: [500, 500, 500, 500, 201, 500, 500, 500, 500, 201]\nassert [500, 500, 50...201, 500, ...] == [201, 201, 20...201, 201, ...]\n  \n  At index 0 diff: 500 != 201\n  \n  Full diff: (-: missing in left side, +: extra in left side)\n    [\n  +     500,\n  +     500,\n  +     500,\n  +     500,\n        201,\n  -     201,\n  ?     ^ ^\n  +     500,\n  ?     ^ ^\n  -     201,\n  ?     ^ ^\n  +     500,\n  ?     ^ ^\n  -     201,\n  ?     ^ ^\n  +     500,\n  ?     ^ ^\n  -     201,\n  ?     ^ ^\n  +     500,\n  ?     ^ ^\n  -     201,\n  -     201,\n  -     201,\n  -     201,\n        201,\n    ]","statusTrace":"settings = Settings(base_url='http://127.0.0.1:8788', admin_username='admin', admin_password='ci-only-45336223913', chromium_executable=None)\nfactory = <mpl_qa.data.factories.PlayerFactory object at 0x715cf0320e10>\ncleanup = <function cleanup.<locals>.track at 0x715cf04be3e0>\n\n    @pytest.mark.regression\n    @pytest.mark.known_bug\n    @pytest.mark.xfail(reason=\"BUG-001: concurrent registrations collide on the generated id\")\n    @allure.issue(\"BUG-001\")\n    @allure.title(\"TC-API-020 Ten players registering at the same moment all succeed\")\n    def test_concurrent_registrations(\n        settings: Settings, factory: PlayerFactory, cleanup: Cleanup\n    ) -> None:\n        bodies = [json.dumps(factory.build().to_api_payload()).encode() for _ in range(10)]\n        start_line = threading.Barrier(len(bodies))\n    \n        def register(body: bytes) -> tuple[int, str]:\n            req = urllib.request.Request(\n                f\"{settings.base_url}/api/registrations\",\n                data=body,\n                headers={\"content-type\": \"application/json\"},\n            )\n            start_line.wait()  # release all requests at the same instant\n            try:\n                with urllib.request.urlopen(req, timeout=30) as res:\n                    return res.status, json.load(res)[\"registration\"][\"id\"]\n            except urllib.error.HTTPError as err:\n                return err.code, \"\"\n    \n        with ThreadPoolExecutor(max_workers=len(bodies)) as pool:\n            results = list(pool.map(register, bodies))\n        for _, reg_id in results:\n            if reg_id:\n                cleanup(reg_id)\n    \n        statuses = [status for status, _ in results]\n>       assert statuses == [201] * len(bodies), f\"lost registrations: {statuses}\"\nE       AssertionError: lost registrations: [500, 500, 500, 500, 201, 500, 500, 500, 500, 201]\nE       assert [500, 500, 50...201, 500, ...] == [201, 201, 20...201, 201, ...]\nE         \nE         At index 0 diff: 500 != 201\nE         \nE         Full diff: (-: missing in left side, +: extra in left side)\nE           [\nE         +     500,\nE         +     500,\nE         +     500,\nE         +     500,\nE               201,\nE         -     201,\nE         ?     ^ ^\nE         +     500,\nE         ?     ^ ^\nE         -     201,\nE         ?     ^ ^\nE         +     500,\nE         ?     ^ ^\nE         -     201,\nE         ?     ^ ^\nE         +     500,\nE         ?     ^ ^\nE         -     201,\nE         ?     ^ ^\nE         +     500,\nE         ?     ^ ^\nE         -     201,\nE         -     201,\nE         -     201,\nE         -     201,\nE               201,\nE           ]\n\ntests/api/test_registrations_api.py:255: AssertionError","flaky":false,"newFailed":false,"newBroken":false,"newPassed":false,"retriesCount":0,"retriesStatusChange":false,"beforeStages":[{"name":"_session_faker","time":{"start":1795499568657,